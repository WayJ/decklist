{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "decklist manifest",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "skill": { "type": "string" },
              "pin": { "type": "string" }
            },
            "required": ["source"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["skills"],
  "additionalProperties": false
}
